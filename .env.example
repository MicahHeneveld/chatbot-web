# --- LLM provider (OpenAI-compatible) ---
# Required for /chat. Set this as a secret; never ship it to the browser.
LLM_API_KEY=

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek alternative:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- Citations ---
# e.g. you/longitudinal_ecg enables GitHub blob citation URLs in the UI.
GITHUB_REPO=
GITHUB_BRANCH=main

# --- App ---
# Comma-separated allowed CORS origins (default: *)
CORS_ORIGINS=*

# Path to the vendored knowledge index (SQLite).
KNOWLEDGE_DB=knowledge/index.sqlite

# Embedding backend: auto | fastembed | local
#   auto/fastembed -> BAAI/bge-small-en-v1.5 (384-dim) if fastembed is installed
#   local          -> deterministic hash embedder (512-dim), no network needed
EMBED_BACKEND=auto
